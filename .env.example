# Prisma (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upload
UPLOAD_DIR=static/images

# PayApp 결제 연동
PAYAPP_USERID=
PAYAPP_GOODNAME=AR-pic 촬영
PAYAPP_RECVPHONE=
PAYAPP_FEEDBACK_URL=https://your-domain.com/api/payments/payapp/feedback
PAYAPP_RETURN_URL=https://your-domain.com/payment/return
# 결제 피드백의 진위 검증용(PayApp 관리자 페이지에서 발급).
# 미설정 시 피드백을 검증 없이 수락하며 경고만 남는다.
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=

# Cron
CRON_SECRET=your-cron-secret

# 관리자 세션 봉인 키 (iron-session). 반드시 32자 이상의 임의 문자열.
# 생성 예: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# 미설정 시 관리자 로그인/인증이 실패한다(fail-loud).
SESSION_PASSWORD=change-me-to-a-random-string-at-least-32-chars
